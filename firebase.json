{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "functions/**",
      "debug_data.cjs",
      "find_bad_lines.cjs",
      "fix_*.cjs",
      "remove_extra_brace.cjs",
      "remove_another_brace.cjs",
      "build-pages.cjs",
      "solve_v17.py",
      "capacitor.config.ts",
      "package.json",
      "package-lock.json",
      "temp_users.json",
      "tiktok-scripts*.md",
      "social-media-posts*.md",
      "www/**",
      "outreach/**"
    ]
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  }
}
