rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Users can only read their own customer data.
    // Client writes limited to local-subscription migration fields; entitlement
    // fields (promoCode, promoExpiresAt, ...) are server-only — otherwise users can self-grant Pro.
    match /customers/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['migratedFromLocalStorage', 'migratedAt']);
      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['migratedFromLocalStorage', 'migratedAt']);
      allow delete: if false;

      // Users can read their own subscriptions
      match /subscriptions/{subscriptionId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if false; // Only server-side (Cloud Functions) can write
      }

      // Users can read their own resume analyses
      match /resumes/{resumeId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if false; // Only server-side (Cloud Functions) can write
      }
    }

    // Role scores for percentile comparison — read: authenticated, write: server-only
    match /roleScores/{role} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Promo codes — authenticated read, server-only write
    match /promoCodes/{code} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Student practice sessions — authenticated write, server-only read
    match /student_sessions/{sessionId} {
      allow create: if request.auth != null;
      allow read, update, delete: if false; // Only Cloud Functions read these
    }

    // Institution stats — admin read, restricted to their own institution
    match /institution_stats/{institutionId} {
      allow read: if request.auth != null
        && exists(/databases/$(database)/documents/institution_admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/institution_admins/$(request.auth.uid)).data.institutionId == institutionId;
      allow write: if false; // Only Cloud Functions write
    }

    // Institution admins — server-managed
    match /institution_admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Super admins — read own doc, write via Cloud Function only
    match /super_admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Audit log — server-only write, super admin read
    match /auditLog/{logId} {
      allow read: if request.auth != null
        && exists(/databases/$(database)/documents/super_admins/$(request.auth.uid));
      allow write: if false; // Only Cloud Functions write
    }

    // Organizations — authenticated read, server-only write
    match /organizations/{orgId} {
      allow read: if request.auth != null;
      allow write: if false; // Only Cloud Functions write

      // Feature policies sub-collection
      match /featurePolicies/{policyId} {
        allow read: if request.auth != null;
        allow write: if false;
      }

      // Discount codes sub-collection
      match /discountCodes/{codeId} {
        allow read: if request.auth != null;
        allow write: if false;
      }
    }

    // Applications — owner read/write; uid is immutable and must match the caller
    match /applications/{appId} {
      allow read, update: if request.auth != null && request.auth.uid == resource.data.uid
        && request.resource.data.uid == resource.data.uid;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
      allow delete: if false;
    }

    // Application events — owner read, authenticated create (must be attributed to caller)
    match /applicationEvents/{eventId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.uid;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // Application cost tracking — server-only
    match /applicationCosts/{costId} {
      allow create: if request.auth != null;
      allow read: if false; // Only server reads for analytics
      allow update, delete: if false;
    }

    // Problem reports — authenticated write, server-only read
    match /reports/{reportId} {
      allow read: if false;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }

    // Jobs — public read, server-only write
    match /jobs/{jobId} {
      allow read: if true;
      allow write: if false; // Only Cloud Functions write
    }

    // Saved jobs — owner read/write
    match /savedJobs/{uid}/jobs/{jobId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Job analytics — authenticated write, server-only read
    match /jobAnalytics/{docId} {
      allow create: if request.auth != null;
      allow read, update, delete: if false;
    }
  }
}
